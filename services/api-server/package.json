{
  "name": "@kalasetu/api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/multipart": "9.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/sensible": "6.0.2",
    "@google/genai": "0.14.1",
    "@imgly/background-removal-node": "^1.4.5",
    "@supabase/supabase-js": "2.46.1",
    "fastify": "5.2.0",
    "fastify-plugin": "5.0.1",
    "jose": "^5.9.6",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "qrcode": "1.5.4",
    "sharp": "^0.33.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
