# ---------- Backend (services/api-server/.env) ----------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Photoroom Image Editing API v2 (AI product studio)
PHOTOROOM_API_KEY=sandbox_xxxxxxxxxxxxxxxxxxxxxxxx

# Sarvam AI (Saaras V4 STT, Mayura translate, Bulbul V4 Flash TTS)
SARVAM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Gemini (structured catalog + pricing). Overridable: Google rotates
# and retires model ids per-key - see services/gemini.service.ts.
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.1-flash-lite

# BharatCode (optional) - OpenAI-compatible fallback LLM, only used after
# Gemini's entire model chain has failed. Leave unset to run Gemini-only.
BHARATCODE_API_KEY=bc_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b

# Supabase (Postgres + Auth + Storage)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
SUPABASE_STORAGE_BUCKET=kalasetu-media
# Publishable (anon) key: used for password sign-in and token refresh.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Pricing engine defaults (INR)
SKILL_RATE_INR_PER_HOUR=95
PACKAGING_COST_INR=45
WHOLESALE_MARGIN=0.28
RETAIL_MARGIN=0.95

# ---------- Mobile (apps/mobile/.env) ----------
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:8080
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
